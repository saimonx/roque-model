   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 3
   },
   "options": {
    "mode": "markdown",
    "content": "**Proyecto independiente, no afiliado a GRANTECAN ni a ningún observatorio.** Datos reales y públicos: estación meteorológica del NOT y previsiones ECMWF y NOAA GFS (Open-Meteo, CC BY 4.0). Pronóstico de la noche: RoqueModel (cúpula cerrada hora a hora) y el seeing previsto (ver docs/DETALLES_TECNICOS.md). Flujo: NGSI-v2 → Orion → QuantumLeap → CrateDB → Grafana."
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Horas de cúpula cerrada previstas",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "cratedb"
   },
   "gridPos": {
    "x": 0,
    "y": 3,
    "w": 4,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "cratedb"
     },
     "format": "table",
     "rawQuery": true,
     "editorMode": "code",
     "rawSql": "SELECT domeclosedhours AS value FROM doc.etweatherforecast WHERE entity_id = 'urn:ngsi-ld:WeatherForecast:ORM-tonight' AND domeclosedhours IS NOT NULL ORDER BY time_index DESC LIMIT 1"
